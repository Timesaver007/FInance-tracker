# Backend environment variables — copy to .env for local dev, set these in the
# host's dashboard (Railway) for prod. Never commit the real .env.

# Postgres connection. Managed Postgres usually needs ?sslmode=require appended.
DATABASE_URL="postgresql://user:password@localhost:5432/finance_tracker?schema=public"

# Long random string used to sign access tokens.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API listens on (Railway injects PORT automatically in prod).
PORT=3001

# Exact origin of the frontend, for CORS (no trailing slash, no wildcard).
FRONTEND_ORIGIN="http://localhost:3000"

# NODE_ENV=production is set by the host in prod. It flips the refresh cookie to
# Secure + SameSite=None so it survives cross-site requests over HTTPS.
